# PostgreSQL container initialization credentials
POSTGRES_DB=nexusgate
POSTGRES_USER=nexusgate_app
POSTGRES_PASSWORD=replace-with-a-local-secret

# Set the same high-entropy value in the Gateway and Management App environments.
# Replace this placeholder; never use it as a deployed secret.
NEXUSHUB_INTERNAL_SHARED_SECRET=replace-with-a-random-shared-secret

# Optional management application overrides
# DATABASE_URL=jdbc:postgresql://localhost:5433/nexusgate
# DATABASE_USERNAME=nexusgate_app
# DATABASE_PASSWORD=replace-with-a-local-secret
